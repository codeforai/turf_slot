# Copy to .env for local development (never commit .env).
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://turfslot:turfslot@localhost:5432/turfslot
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=http://localhost:3000

# Leave empty locally; set a token in production so /metrics is not public
METRICS_TOKEN=

# Booking rules
TIMEZONE=Asia/Kolkata
BOOKING_SLOT_MINUTES=30
BOOKING_HOLD_MINUTES=120
BOOKING_MAX_DAYS_AHEAD=60
CANCELLATION_CUTOFF_MINUTES=60
MAX_PENDING_BOOKINGS_PER_USER=3

# Email: console | smtp | memory
EMAIL_BACKEND=console
EMAIL_FROM=TurfSlot <no-reply@turfslot.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Images: local | cloudinary
STORAGE_BACKEND=local
MEDIA_DIR=media
CLOUDINARY_URL=
MAX_UPLOAD_MB=5

# Tests only: a disposable database whose name contains "test"
TEST_DATABASE_URL=postgresql+psycopg://turfslot:turfslot@localhost:5432/turfslot_test
